# ===================================================
# FinTrack — Production Environment Variables Guide
# ===================================================

# ── Database (Neon.tech / Supabase PostgreSQL) ──
# Get your free PostgreSQL connection string from https://neon.tech (Recommended)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://fintrack_owner:YOUR_PASSWORD@ep-sample-123456.ap-southeast-1.aws.neon.tech/fintrack?sslmode=require"

# ── JWT Security Secrets (Use random 64-char strings) ──
# Generate with: openssl rand -base64 32
JWT_SECRET="generate-a-strong-random-64-character-jwt-secret-key-here"
JWT_REFRESH_SECRET="generate-another-strong-random-64-character-refresh-secret-here"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── API Server Configuration ──
NODE_ENV="production"
PORT=10000

# ── CORS Protection (Frontend URLs) ──
# Comma-separated list of allowed origins (e.g. Vercel deployment URL and custom domain)
CORS_ORIGIN="https://fintrack.vercel.app,http://localhost:3000"

# ── Rate Limiting (Brute-force Protection) ──
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Frontend Environment Variable (Set in Vercel) ──
# NEXT_PUBLIC_API_URL="https://fintrack-api.onrender.com/api/v1"
